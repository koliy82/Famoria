TELEGRAM_TOKEN=TOKEN
CLICKHOUSE_URL=HOST:PORT
CLICKHOUSE_USER=user
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DATABASE=database
MONGO_URI=mongodb://user:password@HOST:PORT/?tls=false&directConnection=true
MONGO_DATABASE=database
MONGO_STEAM_DATABASE=steam_farm
MONGO_FARM_LOGS_COLL_NAME=farm_logs
APP_TIMEZONE=America/Sao_Paulo
ERRORS_CHAT_ID=0
TREE_API_URL=http://localhost:8000
YKASSA_TOKEN=111111111:TEST:11111
YKASSA_PROD=111111111:LIVE:11111
Steam_API_URI=http://steam-api.ru/api
Steam_API_KEY=YOUR-KEY
YTDLP_COOKIES_FILE=./cookies/cookies.txt
PROXY_ENABLE=youtube
PROXY_URL=http://your-proxy

# --- Telegram API proxy ---
# Route all Telegram Bot API traffic (long polling, sends, media uploads, and the
# error-log sink) through a proxy. Needed where api.telegram.org is blocked.
# BOT_PROXY=true requires BOT_PROXY_URL; leaving it true without a URL fails at
# startup rather than silently connecting direct.
BOT_PROXY=false
BOT_PROXY_URL=login:pass@host:port

# --- MongoDB proxy ---
# Route database traffic through a proxy. Needed where the DB host is blocked.
# MongoDB's wire protocol is not HTTP, so this is a raw CONNECT tunnel; the
# driver still performs its own TLS inside it.
DB_PROXY=false
DB_PROXY_URL=login:pass@host:port
